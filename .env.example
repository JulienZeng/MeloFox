# MeloFox 运行配置示例：复制为 .env 后编辑；pnpm dev/start 与 docker compose 都可使用。
# 进程环境优先于 env；env 优先于 YAML。Compose 只传递下列明确映射的运行项，不向镜像复制 env。
# 本文件不用于配置构建代理；构建参数放 .build.env。已有管理台通道不会被重启时的 env 覆盖。
# ---- 运行方式与基础配置 ----
# Compose 使用的镜像名；本地构建可保持默认，拉取已发布镜像时填写完整仓库名。
IMAGE_NAME=melofox

# Compose 使用的镜像标签；应与 .build.env 构建输出的标签一致。
IMAGE_TAG=latest

# Compose 容器名；保留历史默认名称以兼容现有部署，多实例必须使用不同名称。
CONTAINER_NAME=douyin-onebot

# 本机 Node 启动读取的 YAML 路径；Compose 固定为镜像内 /app/config/config.example.yaml。
DOUYIN_ONEBOT_CONFIG=config/config.example.yaml

# 可选：本机 Node 启动的 env 文件路径；应在启动命令的进程环境中指定，留空按 .env、.env.astrbot 顺序选择。Compose 不向容器传入本机 env 文件。
DOUYIN_ONEBOT_ENV_FILE=

# 登录前的 self_id 占位值；认证后使用真实抖音 UID，不用于伪造发送身份。
APP_SELF_ID=douyin_bot_001

# 日志级别：trace/debug/info/warn/error/fatal/silent；日常运行建议 info。
APP_LOG_LEVEL=info

# 仅本机 Node：development 使用易读日志，production 使用结构化日志；Docker 镜像固定 production。
NODE_ENV=development

# ---- 管理台 ----
# 是否启动管理台；true/false。关闭后使用 YAML/env 中的 OneBot 通道配置。
WEB_ENABLED=true

# 仅 Compose：管理端口绑定的宿主机 IP；远程访问改为 0.0.0.0，并完成管理账号首次改密。
WEB_BIND=127.0.0.1

# 仅本机 Node：管理台监听地址；Compose 固定监听容器 0.0.0.0。
WEB_HOST=127.0.0.1

# 本机 Node 的监听端口；Compose 中表示宿主机端口，容器内固定 3000。
WEB_PORT=3000

# 管理账号 melofox 的初始密码，沿用原管理令牌；留空读取/生成 WEB_DATA_DIR/admin-token。首次登录强制改密；已有 admin-credentials.json 时忽略此项，不会重置密码。与 OneBot token 独立，含 #/$ 的值建议单引号包裹。
WEB_TOKEN=

# 仅本机 Node：管理账号凭据、通道和抖音登录资料目录；Compose 固定使用 /data/console。
WEB_DATA_DIR=./data/console

# ---- 浏览器与抖音 ----
# 仅本机 Node：Chromium 持久化资料目录；Compose 固定 /data/douyin-profile，不要由多个实例共享写入。
BROWSER_USER_DATA_DIR=./douyin-profile

# 本机 Node 是否无头运行；Compose 强制 true，容器中通过管理台扫码，不提供桌面显示服务。
BROWSER_HEADLESS=true

# 抖音主站地址，用于会话初始化；通常无需修改。
BROWSER_DOUYIN_URL=https://www.douyin.com/

# 网页版消息页面地址；通常无需修改。
DOUYIN_MESSAGE_PAGE_URL=https://www.douyin.com/chat

# 消息捕获模式：network/injection/dom；正常部署使用 network，其他模式仅用于兼容调试。
DOUYIN_HOOK_MODE=network

# ---- 支持 OneBot 11 通道（首次创建时导入，已有通道请在管理台修改） ----
# OneBot API/WS 鉴权令牌，需与机器人配置一致；为空表示不校验该 token。
ONEBOT_ACCESS_TOKEN=

# *_rate_limited 动作的最小间隔，单位毫秒；范围 0–60000，0 表示不额外等待。
ONEBOT_RATE_LIMIT_INTERVAL_MS=500

# 是否开启 OneBot HTTP API 和媒体服务；即使主要用反向 WS，机器人读取媒体通常仍需要此服务。
ONEBOT_HTTP_ENABLED=true

# 仅 Compose：HTTP 端口的宿主机绑定 IP；跨机器访问时改为 0.0.0.0 并配置 token。
ONEBOT_HTTP_BIND=127.0.0.1

# 仅本机 Node：HTTP 监听地址；Compose 固定容器内 0.0.0.0。
ONEBOT_HTTP_HOST=127.0.0.1

# 本机 HTTP 监听端口；Compose 中表示宿主机端口，容器内固定 3001。
ONEBOT_HTTP_PORT=3001

# 机器人实际可访问的媒体根地址，不是监听地址。机器人在其他容器/机器时不可使用其自身 127.0.0.1；同网可用 http://douyin-onebot:3001，跨机器填宿主机地址和映射端口。
ONEBOT_HTTP_PUBLIC_BASE_URL=http://127.0.0.1:3001

# 是否主动通过反向 WebSocket 连接机器人；AstrBot 通常使用 true。
ONEBOT_REVERSE_WS_ENABLED=true

# 机器人监听的 WS 地址；容器访问宿主机可用 host.docker.internal，本机 Node 部署通常改为 127.0.0.1，路径需与机器人配置一致。
ONEBOT_REVERSE_WS_URL=ws://host.docker.internal:6700/onebot/v11/ws

# 是否开启供机器人主动连接的正向 WS；仅使用反向 WS 时可关闭。
ONEBOT_FORWARD_WS_ENABLED=false

# 仅 Compose：正向 WS 的宿主机绑定 IP；跨机器主动连接时按需改为 0.0.0.0。
ONEBOT_FORWARD_WS_BIND=127.0.0.1

# 仅本机 Node：正向 WS 监听地址；Compose 固定容器内 0.0.0.0。
ONEBOT_FORWARD_WS_HOST=127.0.0.1

# 本机正向 WS 监听端口；Compose 中表示宿主机端口，容器内固定 3002。
ONEBOT_FORWARD_WS_PORT=3002

# 是否通过 HTTP POST 向机器人上报事件；可与 WS 同时启用，下游需自行避免重复业务处理。
ONEBOT_REVERSE_HTTP_ENABLED=false

# 接收事件的完整 HTTP(S) URL；本机 Node 部署通常改为 127.0.0.1 或真实机器人地址。
ONEBOT_REVERSE_HTTP_URL=http://host.docker.internal:5701

# 反向 HTTP HMAC 签名密钥，不等于 ONEBOT_ACCESS_TOKEN；留空不发送签名。
ONEBOT_REVERSE_HTTP_SECRET=

# 每次反向 HTTP 请求超时，单位毫秒；范围 100–60000。
ONEBOT_REVERSE_HTTP_TIMEOUT_MS=10000

# ---- 媒体缓存与转换 ----
# 仅本机 Node：媒体缓存目录；Compose 固定 /data/media-cache。
MEDIA_CACHE_DIR=./media-cache

# 媒体保留时长，单位毫秒；默认 7 天，访问不延长寿命，容量不足会提前淘汰。
MEDIA_CACHE_TTL_MS=604800000

# 媒体过期清理周期，单位毫秒；默认 10 分钟。
MEDIA_CACHE_CLEANUP_INTERVAL_MS=600000

# 已完成媒体总大小上限，单位字节；默认 1 GiB，超限淘汰较旧文件。
MEDIA_CACHE_MAX_BYTES=1073741824

# 已完成媒体数量上限，单位个；正在使用的文件受保护。
MEDIA_CACHE_MAX_FILES=1000

# 单文件下载及转码成品上限，单位字节；默认 128 MiB。
MEDIA_CACHE_MAX_FILE_BYTES=134217728

# 是否将必要的视频转换为 H264/AAC MP4，提升下游播放兼容性。
MEDIA_TRANSCODE_VIDEO_TO_H264=true

# 仅本机 Node：ffmpeg 命令或绝对路径；Compose 固定使用镜像已安装的 ffmpeg。
MEDIA_FFMPEG_PATH=ffmpeg

# 仅本机 Node：ffprobe 命令或绝对路径；Compose 固定使用镜像已安装的 ffprobe。
MEDIA_FFPROBE_PATH=ffprobe

# ---- 运行期媒体下载代理（独立于 .build.env，不自动代理浏览器或 OneBot 连接） ----
# 出站图片/视频 URL 下载的 HTTP 代理；留空直连，消息段 proxy=0 可显式跳过代理。
HTTP_PROXY=

# 出站图片/视频 URL 下载的 HTTPS 代理；容器内不能用宿主机 127.0.0.1，按需用 http://host.docker.internal:端口。
HTTPS_PROXY=

# 运行期媒体下载免代理的主机，逗号分隔；可添加内部媒体服务名称。
NO_PROXY=localhost,127.0.0.1,::1

# ---- 发送与运行时 ----
# 会话恢复失败后的重试间隔，单位毫秒。
RUNTIME_RECONNECT_INTERVAL_MS=5000

# 普通动作总超时，单位毫秒；超时不代表上游必然未执行。
RUNTIME_ACTION_TIMEOUT_MS=15000

# 视频发送总超时，单位毫秒；包含读取、转码、封面、上传及最终提交。
RUNTIME_VIDEO_SEND_TIMEOUT_MS=120000

# 额外允许读取本地图片/视频/文件的目录，JSON 数组，例如 '["/data/uploads"]'。Compose 中必须填写实际挂载到容器的路径；注册媒体缓存无需额外放开。
RUNTIME_FILE_SEND_ALLOWED_DIRS=[]

# 实验性普通文件发送开关；目前最终业务回执仍受 10502 阻塞，保持 false。
RUNTIME_FILE_SEND_ENABLED=false

# true 将收到的分享卡片输出为标题/说明/链接文本；false 保留 share 段，不改变原始缓存。
RUNTIME_SHARE_AS_TEXT=false

# true 将贴纸输出为语义文本；false 下载并输出图片/动画，不影响普通图片或视频。
RUNTIME_STICKER_AS_TEXT=true

# OneBot 心跳间隔，单位毫秒。
RUNTIME_HEARTBEAT_INTERVAL_MS=30000

# 登录状态及消息补偿检查间隔，单位毫秒；群申请轮询至少间隔 60 秒。
RUNTIME_SESSION_CHECK_INTERVAL_MS=30000

# IM 持续断线宽限，单位毫秒；超过后重建浏览器会话并保留持久化资料。
RUNTIME_IM_DISCONNECT_GRACE_MS=60000

# ---- 消息缓存与实时队列 ----
# 每类消息/回执/标记的内存热点数量上限；开启持久化后可从磁盘查询被内存淘汰的记录。
RUNTIME_MESSAGE_CACHE_LIMIT=10000

# 消息和关联记录保留时间，单位毫秒，默认 7 天；查询不续期，认证账号变化时隔离/清理旧记录。
RUNTIME_MESSAGE_CACHE_TTL_MS=604800000

# 是否持久化消息、游标、发送核对及命令去重等记录；不会关闭各 OneBot 通道独立的磁盘事件队列。
RUNTIME_MESSAGE_CACHE_PERSIST=true

# 仅本机 Node：消息记录和 OneBot 事件队列目录；Compose 固定 /data/message-cache。
RUNTIME_MESSAGE_CACHE_DIR=./message-cache

# 消息缓存定期原子保存间隔，单位毫秒；关键记录额外立即保存，正常退出执行最终保存。
RUNTIME_MESSAGE_CACHE_FLUSH_INTERVAL_MS=5000

# 实时待处理消息队列上限，单位条。
RUNTIME_REALTIME_QUEUE_LIMIT=10000

# 同时处理媒体的任务数；媒体任务不阻塞后续文本处理。
RUNTIME_REALTIME_MEDIA_CONCURRENCY=2

# 等待媒体详情/空正文补齐的最长时间，单位毫秒。
RUNTIME_REALTIME_MEDIA_DETAIL_WAIT_MS=5000

# 每个实时媒体处理任务的总超时，单位毫秒。
RUNTIME_REALTIME_MEDIA_TIMEOUT_MS=120000

# ---- Docker 专用（本机 Node 忽略） ----
# 保存 /data 下所有状态的命名卷；多实例使用不同卷名。docker compose down 保留数据，down -v 会删除。旧 ./data 绑定目录迁移方法见 README。
DOCKER_DATA_VOLUME=douyin-onebot-data

# Chromium 使用的共享内存 /dev/shm 大小，支持 Docker 容量格式；默认 1 GiB。
DOCKER_SHM_SIZE=1gb

# 正常停止容器的宽限时间，支持 s/m 等单位；留出媒体任务与缓存保存时间。
DOCKER_STOP_GRACE_PERIOD=120s

# 单个 Docker json-file 日志的轮转大小；不限制应用数据卷大小。
DOCKER_LOG_MAX_SIZE=10m

# Docker 轮转日志最多保留的文件数，正整数。
DOCKER_LOG_MAX_FILES=3
