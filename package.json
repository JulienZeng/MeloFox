{
  "name": "melofox",
  "version": "0.1.0",
  "description": "MeloFox — a OneBot 11 gateway for Douyin group chats and existing private conversations.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts --web-dev",
    "build": "tsc -p tsconfig.json && pnpm build:web",
    "start": "node dist/index.js",
    "test": "pnpm build:web && tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "build:web": "vue-tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:package": "node scripts/release.mjs package"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.2.1",
    "lossless-json": "^4.3.1",
    "pino": "^9.6.0",
    "playwright": "^1.49.1",
    "protobufjs": "^7.5.4",
    "undici": "^6.21.3",
    "ws": "^8.18.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vue": "^3.5",
    "vue-router": "^4.6",
    "vue-tsc": "^3"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
