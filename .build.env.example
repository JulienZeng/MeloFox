# MeloFox 构建配置示例：复制为 .build.env 后由 ./build-multiarch.sh 读取。
# 这是 Bash source 文件；含空格/特殊字符的值请加引号，不要加入不可信命令。
# 可在启动脚本前设置 BUILD_ENV_FILE=/path/to/build.env 切换文件；文件内容覆盖同名进程变量。
# 所有代理均由 env 提供，不写死在脚本或镜像 ENV 中。构建文件不用于运行部署。
# ---- 镜像与构建器 ----
# 镜像仓库名；推送前改成自己的仓库，并先 docker login。不要在镜像名中填写密码。
IMAGE_NAME=ghcr.io/your-name/melofox

# 构建输出标签；应与部署 .env 的 IMAGE_TAG 一致。
IMAGE_TAG=latest

# 目标平台，逗号分隔；BUILD_OUTPUT=load 时只允许一个平台。
PLATFORMS=linux/amd64,linux/arm64

# 输出方式：push 推送仓库；load 导入本机 Docker（单平台）；cache 仅构建缓存，不推送/导入镜像。
BUILD_OUTPUT=push

# 使用的 Buildx 构建器名；不存在时创建 docker-container 构建器，不改变全局选中项。
BUILDER_NAME=douyin-onebot-builder

# Dockerfile 路径，相对于项目根目录。
DOCKERFILE=Dockerfile

# 构建上下文路径，相对于项目根目录；受 .dockerignore 白名单控制。
CONTEXT=.

# 官方 Playwright 基础镜像版本，必须与 pnpm-lock.yaml 的 playwright 完全一致；构建时会校验。
PLAYWRIGHT_VERSION=1.63.0

# 构建阶段安装的 pnpm 版本；需支持当前 pnpm-lock.yaml 格式。
PNPM_VERSION=9.15.3

# 安装 pnpm 和项目依赖的 npm 源；可改为可信镜像源，不要在 URL 内填写认证凭据。
NPM_REGISTRY=https://registry.npmjs.org

# ---- 构建机代理（由脚本自动导出；只影响宿主机上的 Docker CLI 等进程） ----
# 构建机 HTTP 代理地址；例如 http://127.0.0.1:10808，留空不设置代理。
HTTP_PROXY=

# 构建机 HTTPS 请求所用代理；HTTP CONNECT 代理仍填写 http:// 开头的地址。
HTTPS_PROXY=

# 构建机通用/SOCKS 代理；例如 socks5://127.0.0.1:10808，不同客户端支持程度不同。
ALL_PROXY=

# 构建机不走代理的主机列表，逗号分隔；按需加入内网仓库域名。
NO_PROXY=localhost,127.0.0.1,::1

# 小写 HTTP 代理兼容项，默认跟随 HTTP_PROXY。
http_proxy="${HTTP_PROXY}"

# 小写 HTTPS 代理兼容项，默认跟随 HTTPS_PROXY。
https_proxy="${HTTPS_PROXY}"

# 小写通用代理兼容项，默认跟随 ALL_PROXY。
all_proxy="${ALL_PROXY}"

# 小写代理例外兼容项，默认跟随 NO_PROXY。
no_proxy="${NO_PROXY}"

# ---- 构建容器代理（不能用宿主机的 127.0.0.1） ----
# RUN 下载及新建 BuildKit 的 HTTP 代理；Docker Desktop 可用 http://host.docker.internal:10808。Linux BuildKit 若无法解析该名称，填写可达的宿主机 IP；代理需允许容器访问。留空不显式传入。
BUILD_HTTP_PROXY=

# RUN 下载及新建 BuildKit 容器使用的 HTTPS 代理，通常与 BUILD_HTTP_PROXY 相同。
BUILD_HTTPS_PROXY=

# 构建容器的通用代理，可留空；apt/npm 更适合显式 HTTP(S) 代理。
BUILD_ALL_PROXY=

# 构建容器免代理主机列表；新建构建器配置后生效，已有构建器不会被脚本自动重建。
BUILD_NO_PROXY=localhost,127.0.0.1,::1
